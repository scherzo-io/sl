# Auto detect text files and perform LF normalization
* text=auto

# Data extracts: text, LF, and diff-as-text so review works
*.tsv text eol=lf
*.csv text eol=lf
*.md  text eol=lf
*.xml text eol=lf
*.py  text eol=lf

# Sources that must never be line-ending-mangled
*.xlsx binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.pdf  binary
*.docx binary
*.woff binary
*.woff2 binary
